{
  "api_version": 1,
  "id": "music-downloader",
  "name": "无损音乐下载",
  "version": "0.1.0",
  "description": "搜索可配置音乐站点，在后台下载到 NAS 目录并按歌名整理文件",
  "runtime": {
    "entrypoint": "./plugin"
  },
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "secret_fields": [
    "cookie"
  ],
  "interactive_view": {
    "title": "无损音乐下载",
    "eyebrow": "音乐搜索",
    "action": "search",
    "trigger": {
      "label": "搜索音乐",
      "icon": "music"
    },
    "submit": {
      "label": "搜索",
      "pending_label": "搜索中",
      "icon": "search"
    },
    "fields": [
      {
        "key": "query",
        "type": "text",
        "placeholder": "输入歌名或歌手",
        "required": true,
        "autofocus": true,
        "icon": "search"
      }
    ],
    "empty": {
      "text": "输入歌名或歌手开始搜索",
      "icon": "music"
    },
    "empty_result_text": "没有找到匹配的音乐。",
    "error_message": "音乐站请求失败，请检查站点地址和 Cookie。"
  },
  "settings_schema": {
    "sections": [
      {
        "title": "站点设置",
        "fields": [
          {
            "key": "$enabled",
            "type": "switch",
            "label": "启用插件",
            "default": false
          },
          {
            "key": "base_url",
            "type": "text",
            "label": "音乐站地址",
            "default": "https://flac.music.hi.cn",
            "placeholder": "https://flac.music.hi.cn",
            "span": 2
          },
          {
            "key": "cookie",
            "type": "text",
            "label": "站点 Cookie",
            "placeholder": "遇到防护验证时填写浏览器 Cookie",
            "span": 2
          },
          {
            "key": "result_limit",
            "type": "number",
            "label": "搜索结果数",
            "default": 30,
            "min": 1,
            "max": 100,
            "step": 1
          },
          {
            "key": "platform",
            "type": "select",
            "label": "搜索平台",
            "default": "kuwo",
            "options": [
              {"label": "酷我", "value": "kuwo"},
              {"label": "网易云", "value": "wyy"}
            ]
          },
          {
            "key": "quality",
            "type": "select",
            "label": "下载音质",
            "default": "flac",
            "options": [
              {"label": "FLAC 无损", "value": "flac"},
              {"label": "320 kbps", "value": "320"},
              {"label": "128 kbps", "value": "128"}
            ]
          }
        ]
      },
      {
        "title": "下载与整理",
        "fields": [
          {
            "key": "download_path",
            "type": "text",
            "label": "NAS 下载目录",
            "placeholder": "/media/music",
            "help": "必须是 Mediary 容器内可写的绝对路径；请先把 NAS 目录挂载到容器。",
            "span": 2
          },
          {
            "key": "filename_format",
            "type": "select",
            "label": "文件名格式",
            "default": "title",
            "options": [
              {"label": "歌名", "value": "title"},
              {"label": "歌手 - 歌名", "value": "artist-title"}
            ]
          },
          {
            "key": "overwrite",
            "type": "switch",
            "label": "覆盖同名文件",
            "default": false
          }
        ]
      },
      {
        "title": "说明",
        "alert": "下载由插件后台进程完成，先写入 .part 临时文件，完整下载后再改为正式歌名。qBittorrent 不支持普通 HTTP 音频直链，因此本插件不经qB。请仅下载你有权使用的内容。",
        "fields": []
      }
    ]
  }
}

{
  "api_version": 1,
  "id": "mcp-server",
  "name": "MCP Server",
  "version": "0.2.0",
  "description": "为 Mediary 提供 MCP 服务，支持 OpenClaw、Hermes 等 AI 客户端通过 /mcp 使用目录、订阅、下载和通知工具。",
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "external_actions": ["mcp"],
  "requested_scopes": [
    "catalog:read",
    "subscriptions:read",
    "subscriptions:write",
    "downloads:read",
    "downloads:create",
    "downloads:write",
    "torrents:read",
    "downloader:read",
    "sites:read",
    "filters:read",
    "filters:write",
    "logs:read",
    "notifications:send"
  ],
  "auto_grant_scopes": false,
  "settings_schema": {
    "sections": [
      {
        "title": "基础设置",
        "fields": [
          {
            "key": "$enabled",
            "type": "switch",
            "label": "启用 MCP 服务",
            "help": "启用后对外开放 /mcp 端点（与 Mediary 共用端口）。需在下方权限设置中手动勾选所需权限，并在上方填写 Mediary 访问地址。",
            "default": false
          },
          {
            "key": "public_url",
            "type": "text",
            "label": "Mediary 访问地址",
            "placeholder": "http://192.168.x.x:8118",
            "help": "填写你浏览器中访问 Mediary 的完整地址（含端口），用于自动生成 MCP 连接地址。例如 http://192.168.10.150:8118"
          }
        ]
      }
    ]
  },
  "secret_fields": [],
  "interactive_view": {
    "title": "MCP Server",
    "eyebrow": "AI 连接服务",
    "action": "status",
    "trigger": {
      "label": "查看状态",
      "icon": "info"
    },
    "submit": {
      "label": "刷新",
      "pending_label": "查询中",
      "icon": "refresh"
    },
    "auto_run": true,
    "layout": "list",
    "fields": [],
    "empty": {
      "text": "MCP 服务运行中 — 端点 /mcp（与 Mediary 共用端口）| 已支持 18 个工具",
      "icon": "server"
    },
    "empty_result_text": "暂未获取到状态。请确认插件已启用并配置了 Mediary 访问地址。",
    "error_message": "MCP 服务状态查询失败。"
  }
}

{
  "api_version": 1,
  "id": "mcp-server",
  "name": "MCP Server",
  "version": "0.1.2",
  "description": "为 Mediary 提供 MCP (Model Context Protocol) 服务，通过 /mcp 端点接收 OpenClaw、Hermes 等 AI 客户端请求，实现 AI 对话中直接调用 Mediary 全部功能。",
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "requested_scopes": [
    "catalog:read",
    "subscriptions:read",
    "subscriptions:write",
    "downloads:read",
    "downloads:create",
    "downloads:write",
    "torrents:read",
    "downloader:read",
    "sites:read",
    "filters:read",
    "filters:write",
    "logs:read",
    "notifications:send",
    "integrations:read",
    "integrations:run"
  ],
  "auto_grant_scopes": false,
  "settings_schema": {
    "sections": [
      {
        "title": "基础设置",
        "fields": [
          {
            "key": "$enabled",
            "type": "switch",
            "label": "启用 MCP 服务",
            "help": "启用后 MCP 服务通过 /mcp 端点（与 Mediary 共用端口）接收 AI 客户端请求。首次启用需在下方权限设置中手动勾选所需权限。",
            "default": false
          }
        ]
      },
      {
        "title": "API Token 鉴权",
        "fields": [
          {
            "key": "mcp_api_token",
            "type": "text",
            "label": "MCP 访问令牌",
            "placeholder": "留空则不启用鉴权",
            "help": "设置后 AI 客户端需在请求 Header 中携带 Authorization: Bearer <Token> 才能访问 /mcp 端点。令牌由 Mediary 代理层验证。"
          }
        ]
      }
    ]
  },
  "secret_fields": ["mcp_api_token"],
  "interactive_view": {
    "title": "MCP Server",
    "eyebrow": "AI 连接服务",
    "action": "status",
    "trigger": {
      "label": "查看状态",
      "icon": "info"
    },
    "submit": {
      "label": "刷新",
      "pending_label": "查询中",
      "icon": "refresh"
    },
    "auto_run": true,
    "layout": "list",
    "fields": [],
    "empty": {
      "text": "MCP 服务运行中 — 端点 /mcp（与 Mediary 共用端口）| 已支持 18 个工具",
      "icon": "server"
    },
    "empty_result_text": "MCP 服务未运行。请在设置中启用该插件。",
    "error_message": "MCP 服务状态查询失败。"
  }
}

{
  "api_version": 1,
  "id": "tmdb-trending",
  "name": "TMDB 热门",
  "version": "0.2.0",
  "description": "按国内剧集、国外剧集、国内电影、国外电影和动漫浏览 TMDB 热门内容",
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "requested_scopes": [
    "catalog:read",
    "subscriptions:read"
  ],
  "auto_grant_scopes": true,
  "interactive_view": {
    "action": "browse",
    "layout": "poster_grid",
    "minimal": true,
    "auto_run": true,
    "trigger": {
      "label": "打开",
      "icon": "film"
    },
    "fields": [],
    "empty": {
      "text": "正在加载分类内容",
      "icon": "film"
    },
    "empty_result_text": "当前没有可显示的分类内容。",
    "error_message": "TMDB 热门加载失败，请检查 Mediary 的 TMDB 配置。"
  },
  "settings_schema": {
    "sections": [
      {
        "fields": [
          {
            "key": "$enabled",
            "type": "switch",
            "label": "启用插件",
            "default": true
          }
        ]
      }
    ]
  }
}

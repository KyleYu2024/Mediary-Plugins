{
  "api_version": 1,
  "id": "115-checkin",
  "name": "115 签到",
  "version": "0.1.3",
  "description": "使用独立配置的 115 Cookie 执行安卓端积分签到，并可定时发送结果通知",
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "scheduled_actions": [
    {
      "action": "checkin",
      "label": "手动签到",
      "manual": true,
      "cron_setting": "cron",
      "timeout_seconds": 60
    }
  ],
  "requested_scopes": [
    "notifications:send"
  ],
  "auto_grant_scopes": true,
  "secret_fields": [
    "cookie"
  ],
  "settings_schema": {
    "sections": [
      {
        "title": "签到设置",
        "fields": [
          {
            "key": "$enabled",
            "type": "switch",
            "label": "启用插件",
            "default": false
          },
          {
            "key": "cookie",
            "type": "text",
            "label": "115 Cookie",
            "placeholder": "UID=...; CID=...; SEID=...",
            "help": "从已登录的 115 Web 请求中复制完整 Cookie；保存后会脱敏显示。",
            "span": 2
          },
          {
            "key": "cron",
            "type": "text",
            "label": "签到时间",
            "default": "5 0 * * *",
            "placeholder": "5 0 * * *",
            "help": "5 段 cron 表达式，按 Mediary 所在时区执行。"
          },
          {
            "key": "notify",
            "type": "switch",
            "label": "发送签到通知",
            "default": true
          }
        ]
      },
      {
        "title": "说明",
        "alert": "签到使用 115 安卓端的每日积分签到接口。Cookie 仅发送给 115，不会写入运行记录或通知。",
        "fields": []
      }
    ]
  },
  "data_view": {
    "title": "115 签到记录",
    "file": "data/history.json",
    "item_label": "运行记录",
    "summary": [
      {
        "key": "runs",
        "label": "运行次数"
      },
      {
        "key": "successes",
        "label": "成功次数"
      },
      {
        "key": "last_result",
        "label": "最近结果"
      },
      {
        "key": "last_run_at",
        "label": "最近运行"
      }
    ],
    "fields": [
      {
        "key": "result",
        "label": "结果",
        "primary": true
      },
      {
        "key": "points",
        "label": "签到积分"
      },
      {
        "key": "continuous_day",
        "label": "连续签到天数"
      },
      {
        "key": "trigger",
        "label": "触发方式"
      },
      {
        "key": "finished_at",
        "label": "完成时间"
      }
    ]
  }
}

{
  "api_version": 1,
  "id": "smzdm-checkin",
  "name": "什么值得买签到",
  "version": "0.1.3",
  "description": "使用什么值得买 App 接口为单个账号执行每日签到，支持协议回退和失效通知",
  "action_runtime": {
    "entrypoint": "./plugin"
  },
  "scheduled_actions": [
    {
      "action": "checkin",
      "label": "立即签到",
      "manual": true,
      "cron_setting": "cron",
      "timeout_seconds": 120
    }
  ],
  "requested_scopes": [
    "cookiecloud:read",
    "notifications:send"
  ],
  "cookiecloud_domains": [
    "smzdm.com"
  ],
  "auto_grant_scopes": true,
  "secret_fields": [
    "cookies"
  ],
  "settings_schema": {
    "sections": [
      {
        "title": "签到设置",
        "fields": [
          {
            "key": "$enabled",
            "type": "switch",
            "label": "启用插件",
            "default": false
          },
          {
            "key": "use_cookiecloud",
            "type": "switch",
            "label": "优先使用 Mediary CookieCloud",
            "default": true,
            "help": "每次签到前从 Mediary 已配置的 CookieCloud 读取 smzdm.com 最新 Cookie。"
          },
          {
            "key": "cookies",
            "type": "text",
            "label": "手工 Cookie（可选兜底）",
            "placeholder": "sess=...; device_id=...",
            "help": "CookieCloud 未配置或未找到 Cookie 时使用；仅支持一个账号。保存后会脱敏显示。",
            "span": 2
          },
          {
            "key": "cron",
            "type": "text",
            "label": "签到时间",
            "default": "23 7 * * *",
            "placeholder": "23 7 * * *",
            "help": "5 段 cron 表达式，按 Mediary 所在时区执行。"
          },
          {
            "key": "notify",
            "type": "switch",
            "label": "发送签到通知",
            "default": true
          }
        ]
      },
      {
        "title": "说明",
        "alert": "插件只执行每日签到，不会自动点赞、收藏、评论、抽奖或申请众测。遇到 Cookie 失效、验证码、风控或接口协议变化时会明确报错并通知。",
        "fields": []
      }
    ]
  },
  "data_view": {
    "title": "什么值得买签到记录",
    "file": "data/history.json",
    "item_label": "签到记录",
    "summary": [
      {
        "key": "runs",
        "label": "运行次数"
      },
      {
        "key": "account_attempts",
        "label": "签到次数"
      },
      {
        "key": "successes",
        "label": "成功次数"
      },
      {
        "key": "last_result",
        "label": "最近结果"
      },
      {
        "key": "last_run_at",
        "label": "最近运行"
      }
    ],
    "fields": [
      {
        "key": "result",
        "label": "结果",
        "primary": true
      },
      {
        "key": "points",
        "label": "本次积分"
      },
      {
        "key": "continuous_day",
        "label": "连续签到天数"
      },
      {
        "key": "protocol",
        "label": "签到协议"
      },
      {
        "key": "source",
        "label": "Cookie 来源"
      },
      {
        "key": "finished_at",
        "label": "完成时间"
      }
    ]
  }
}
